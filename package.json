{
  "name": "@rapidd/build",
  "version": "2.0.3",
  "description": "Dynamic code generator that transforms Prisma schemas into Fastify CRUD APIs with PostgreSQL RLS-to-TypeScript translation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "rapidd": "./dist/bin/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist/ output/ routes/ acl-mappings.json",
    "dev": "tsx bin/cli.ts",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MertDalbudak/rapidd-build"
  },
  "bugs": {
    "url": "https://github.com/MertDalbudak/rapidd-build/issues"
  },
  "homepage": "https://github.com/MertDalbudak/rapidd-build#readme",
  "keywords": [
    "rapidd",
    "prisma",
    "code-generation",
    "orm",
    "fastify",
    "typescript",
    "routes",
    "rls",
    "row-level-security",
    "crud",
    "api-generator",
    "postgresql",
    "mysql",
    "database",
    "security",
    "access-control",
    "authentication",
    "authorization"
  ],
  "author": "Rapidd Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.0.1",
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.0.1",
    "@prisma/internals": "^7.0.1",
    "commander": "^11.0.0",
    "dotenv": "^16.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.0.0",
    "prisma": "^7.0.1",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "@prisma/client": "^7.0.1"
  }
}
