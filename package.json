{
  "name": "@rapidd/build",
  "version": "2.1.6",
  "description": "Dynamic code generator that transforms Prisma schemas into Fastify CRUD APIs with TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "rapidd": "./dist/bin/cli.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/bin/cli.js",
    "clean": "rm -rf dist/ output/ routes/ acl-mappings.json",
    "dev": "tsx bin/cli.ts",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MertDalbudak/rapidd-build"
  },
  "bugs": {
    "url": "https://github.com/MertDalbudak/rapidd-build/issues"
  },
  "homepage": "https://github.com/MertDalbudak/rapidd-build#readme",
  "keywords": [
    "rapidd",
    "prisma",
    "prisma7",
    "code-generation",
    "codegen",
    "scaffold",
    "orm",
    "fastify",
    "typescript",
    "routes",
    "crud",
    "rest-api",
    "api-generator",
    "model-generator",
    "route-generator",
    "acl",
    "access-control",
    "schema",
    "dmmf"
  ],
  "author": "Mert Dalbudak",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@prisma/internals": "^7.0.1",
    "commander": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prisma": "^7.0.1",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "@prisma/client": "^7.0.1"
  }
}
